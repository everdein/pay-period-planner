flowchart TB
  accTitle: Pay Period Planner application architecture
  accDescr: A canonical local draft is distinct from the last server snapshot in Redux. HTTP requests cross a session, CSRF and workspace authorization boundary before reaching versioned relational storage.
  subgraph client["Browser state"]
    ui["React workspace
Forms, projections and recovery feedback"]
    draft["Canonical draft reducer
Baseline, local edits and draft revision"]
    redux["Redux slice
Last server snapshot and request status"]
    http["HTTP client
Session cookie, CSRF proof, workspace header"]
    ui -->|"Local edit commands"| draft
    redux -->|"Synchronize baseline"| draft
    draft -->|"Explicit save through thunk"| http
    http -->|"Server response or structured failure"| redux
  end
  subgraph server["Spring Boot API"]
    security["HTTP and security boundary
Session, CSRF and membership checks"]
    services["Query / command services
Validation and expected version"]
    persistence["Repository + relational adapter
Workspace lock and atomic replacement"]
    security --> services
    services --> persistence
  end
  client -->|"GET / PUT /api/v1/financials"| server
  server -->|"Workspace-scoped reads and transactional writes"| pg[("PostgreSQL
Financial records and audit events")]
