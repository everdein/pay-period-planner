{
  "name": "pay-period-planner-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "capture:portfolio": "playwright test --config playwright.portfolio.config.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:a11y": "playwright test e2e/accessibility.spec.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:responsive": "playwright test e2e/responsive.spec.ts",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "check:dependency-compat": "node scripts/check-dependency-compatibility.cjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.21"
    }
  }
}
